# StarCAD — yerel dev ortam değişkenleri (docker-compose bunu okur).
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` gitignore'ludur (commit edilmez).
#
# TC kimlik (KVKK) şifreleme anahtarları — base64, 32-byte.
# Üretmek için:  openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_HMAC_KEY=

# Tarayıcının API/MinIO'ya ulaştığı host (ŞEMASIZ, portsuz — sadece ip/hostname).
# Yerelde boş bırakılabilir (varsayılan: localhost). Ortak sunucuda ŞART: tarayıcı
# başka bir makinede olduğu için "localhost" presigned URL'i çöker.
# Örn: PUBLIC_HOST=192.168.1.50
PUBLIC_HOST=
